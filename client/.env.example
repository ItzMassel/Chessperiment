# ─── Required for all modes ─────────────────────────────────────────
NEXT_PUBLIC_SOCKET_URL=https://chessperiment.app/chessperiment-server
# Public origin of the app. NextAuth builds the Google OAuth redirect_uri from this
# (<origin>/api/auth/callback/google). In production set BOTH to the public https
# origin (e.g. https://chessperiment.app); a wrong/unset value behind a proxy makes
# NextAuth emit http:// and Google returns "Error 400: redirect_uri_mismatch".
NEXTAUTH_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
AUTH_SECRET=generate-a-random-secret-here
AUTH_TRUST_HOST=true
# Only for ephemeral preview deploys (pr-N.chessperiment.app) whose origin can't be
# registered in Google. Point it at a stable, registered auth endpoint (beta) to
# proxy the OAuth callback; leave empty for local/prod/beta. Beta and the preview
# must share AUTH_SECRET. Set automatically by pr-preview-deploy.yml.
AUTH_REDIRECT_PROXY_URL=

# ─── Database ────────────────────────────────────────────────────────
# Self-hosted PostgreSQL connection string, e.g.
# postgresql://user:password@localhost:5432/chessperiment
# (Formerly a Supabase-hosted Postgres URL; the app only ever used Supabase
# here as a managed Postgres host via Drizzle, so any Postgres 14+ works.)
SUPABASE_DB_URL=

# ─── File uploads (avatars, marketplace thumbnails) ─────────────────
# No config needed: handled by app/actions/storage.ts, which writes to
# client/public/uploads/ on local disk (previously Supabase Storage).

# ─── Auth ────────────────────────────────────────────────────────────
# Email/password + Google OAuth via NextAuth, backed by the Postgres `users`/
# `accounts` tables (see auth.ts, app/actions/auth.ts). Firebase Auth and the
# Firestore adapter have been removed.

# NextAuth / Google OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Transitional only: verifies existing users' passwords against Firebase once
# (via REST, not the Admin SDK) and migrates them to a local bcrypt hash on
# success. Safe to delete this var once essentially all users have logged in
# since the cutover — see lib/firebase-legacy-auth.ts.
FIREBASE_LEGACY_WEB_API_KEY=

# ─── Optional services ──────────────────────────────────────────────
RESEND_API_KEY=
ADMIN_PASSWORD_HASH=
ADMIN_JWT_SECRET=
OLLAMA_API_KEY=
DEEPSEEK_API_KEY=

# ─── Vercel (only needed for Vercel deployment) ─────────────────────
VERCEL_OIDC_TOKEN=
